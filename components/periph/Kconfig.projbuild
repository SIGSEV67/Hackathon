menu "SIGSEV: hardware (periph)"

    config HACK_SPEAKER_ENABLE
        bool "Enable speaker (I2S1)"
        default y
        help
            Drive an I2S amplifier (MAX98357A or similar) for voice playback
            and calls. With nothing connected the pins just toggle, so it is
            safe to leave on. When disabled, playback returns
            ESP_ERR_NOT_SUPPORTED. The PDM microphone on I2S0 works either way.

    config HACK_SPEAKER_DIN_GPIO
        int "Speaker DIN GPIO"
        depends on HACK_SPEAKER_ENABLE
        default 4

    config HACK_SPEAKER_BCLK_GPIO
        int "Speaker BCLK GPIO"
        depends on HACK_SPEAKER_ENABLE
        default 5

    config HACK_SPEAKER_LRCLK_GPIO
        int "Speaker LRCLK (WS) GPIO"
        depends on HACK_SPEAKER_ENABLE
        default 6

    config HACK_SPEAKER_VOLUME
        int "Speaker volume (percent of full scale)"
        depends on HACK_SPEAKER_ENABLE
        range 1 100
        default 40
        help
            Scale applied to everything that goes to the speaker. Voices are
            already normalized to near full scale. The MAX98357A is loud,
            keep it low when testing at a desk.

    config HACK_DISPLAY_ROTATE_180
        bool "Rotate display by 180 degrees"
        default n
        help
            Enable if the text on the OLED appears upside down.

endmenu
